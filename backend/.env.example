# Copy to .env:  cp .env.example .env

# Docker Postgres (see docker-compose.yml — port 5433, user iskcon)
DATABASE_URL=postgresql+psycopg://iskcon:iskcon@localhost:5433/iskcon_temple

SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Razorpay Test Mode keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
# Webhook signing secret from Dashboard → Webhooks (required for POST /api/payments/webhook)
RAZORPAY_WEBHOOK_SECRET=

# Verbose API logs
DEBUG=false

ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMeSecure123!
